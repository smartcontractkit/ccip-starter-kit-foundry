ETHEREUM_SEPOLIA_RPC_URL=https://your-ethereum-sepolia-rpc-url
AVALANCHE_FUJI_RPC_URL=https://your-avalanche-fuji-rpc-url
POLYGON_AMOY_RPC_URL=https://your-polygon-amoy-rpc-url
BASE_SEPOLIA_RPC_URL=https://your-base-sepolia-rpc-url

# Your account address. Fill in with: cast wallet address --account myAccount
MY_EOA=

# Network constants used by the book (book/src). Fill these in from https://docs.chain.link/ccip/directory
# (router, chain selector, LINK, CCIP-BnM, RMN/ARM proxy, registry module owner, token admin registry).
# Only fill the chains you plan to run.
# Ethereum Sepolia
SEPOLIA_CHAIN_SELECTOR=
SEPOLIA_ROUTER=
SEPOLIA_LINK=
SEPOLIA_CCIP_BNM=
SEPOLIA_ARM_PROXY=
SEPOLIA_REGISTRY_MODULE_OWNER_CUSTOM=
SEPOLIA_TOKEN_ADMIN_REGISTRY=
# Polygon Amoy
AMOY_CHAIN_SELECTOR=
AMOY_ROUTER=
AMOY_LINK=
AMOY_CCIP_BNM=
AMOY_ARM_PROXY=
AMOY_REGISTRY_MODULE_OWNER_CUSTOM=
AMOY_TOKEN_ADMIN_REGISTRY=
# Avalanche Fuji (Legacy examples)
FUJI_CHAIN_SELECTOR=
FUJI_ROUTER=
FUJI_LINK=
FUJI_CCIP_BNM=

# Optional. The SDK examples (sdk-examples) read USER_KEY (or PRIVATE_KEY) for non-dry-run sends.
# USER_KEY=

# Optional. Fork tests (test/fork, FOUNDRY_PROFILE=fork) are pinned to the blocks in test/fork/utils/CCTForkTest.sol.
# Set these to run against a different block, for example a recent one to check whether the live lane has drifted.
# ETHEREUM_SEPOLIA_FORK_BLOCK=<block number>
# POLYGON_AMOY_FORK_BLOCK=<block number>
